{
  "name": "flexlab",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "FlexLab — local multimodal AI studio, model manager, and OpenAI/LM Studio-compatible server.",
  "author": "Pifo",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "native": "node native/server.mjs",
    "dev:real": "node scripts/dev-real.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:native": "node --check native/server.mjs && node --check native/llama-manager.mjs && node --check native/downloader.mjs && node --check native/runtime-installer.mjs && node --check native/image-manager.mjs && node --check native/mcp.mjs && node --check electron/main.mjs",
    "desktop": "electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:build": "npm run build && electron-builder --win nsis portable --publish never",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-router": "^1.170.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.pifo.flexlab",
    "productName": "FlexLab",
    "asar": true,
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "native/**/*", "build/icon.png", "package.json"],
    "extraMetadata": {"main": "electron/main.mjs"},
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true},
    "asarUnpack": ["native/**/*", "node_modules/**/*"]
  }
}
